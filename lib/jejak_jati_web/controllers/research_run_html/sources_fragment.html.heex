<section
  id="source-results"
  class="mt-8"
  hx-get={
    if @research_run.status in [:pending, :running],
      do: ~p"/research-runs/#{@research_run}/fragments/sources",
      else: nil
  }
  hx-trigger={
    if @research_run.status in [:pending, :running],
      do: "every 2s",
      else: nil
  }
  hx-swap="outerHTML"
>
  <div class="flex items-center justify-between">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-fuchsia-700">
        Quellen
      </p>

      <h2 class="mt-2 text-2xl font-semibold tracking-tight">
        Rechercheergebnisse
      </h2>
    </div>
  </div>

  <div class="mt-6 space-y-4">
    <%= if Enum.empty?(@source_requests) do %>
      <div class="rounded-2xl border border-zinc-200 bg-white p-6 text-zinc-500 shadow-sm">
        Recherche läuft …
      </div>
    <% else %>
      <%= for request <- @source_requests do %>
        <article class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <h3 class="text-lg font-semibold text-zinc-950">
                {source_label(request.source)}
              </h3>

              <p class="mt-1 text-sm text-zinc-500">
                {source_status_label(request.status)}
              </p>
            </div>

            <%= if request.decision do %>
              <span class="inline-flex w-fit rounded-full border border-zinc-200 bg-zinc-50 px-3 py-1 text-xs font-medium text-zinc-700">
                {decision_label(request.decision)}
              </span>
            <% end %>
          </div>

          <dl class="mt-6 grid gap-4 sm:grid-cols-3">
            <div>
              <dt class="text-xs font-medium uppercase tracking-wide text-zinc-500">
                Kandidaten
              </dt>
              <dd class="mt-1 text-lg font-semibold text-zinc-900">
                {request.candidate_count}
              </dd>
            </div>
            <%= if request.source_candidates != [] do %>
              <div class="mt-6 border-t border-zinc-200 pt-6">
                <h4 class="text-sm font-semibold uppercase tracking-[0.16em] text-zinc-500">
                  Kandidaten
                </h4>

                <div class="mt-4 space-y-4">
                  <%= for candidate <- request.source_candidates do %>
                    <div class="rounded-xl border border-zinc-200 bg-zinc-50 p-4">
                      <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                        <div class="min-w-0">
                          <p class="font-semibold text-zinc-950">
                            {candidate.title}
                          </p>

                          <%= if candidate.author_name do %>
                            <p class="mt-1 text-sm text-zinc-600">
                              {candidate.author_name}
                            </p>
                          <% end %>

                          <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs text-zinc-500">
                            <%= if candidate.publication_year do %>
                              <span>
                                Jahr: {candidate.publication_year}
                              </span>
                            <% end %>

                            <%= if candidate.isbn do %>
                              <span>
                                ISBN: {candidate.isbn}
                              </span>
                            <% end %>

                            <%= if candidate.publisher do %>
                              <span>
                                {candidate.publisher}
                              </span>
                            <% end %>
                          </div>
                        </div>

                        <div class="shrink-0 text-left sm:text-right">
                          <p class="text-xs font-medium uppercase tracking-wide text-zinc-500">
                            Score
                          </p>

                          <p class="mt-1 text-xl font-semibold text-zinc-950">
                            {candidate.score}
                          </p>
                        </div>
                      </div>

                      <%= if map_size(candidate.match_reasons) > 0 do %>
                        <div class="mt-4 flex flex-wrap gap-2">
                          <%= for {reason, points} <- candidate.match_reasons do %>
                            <span class="rounded-full border border-zinc-200 bg-white px-2.5 py-1 text-xs text-zinc-600">
                              {match_reason_label(reason)} +{points}
                            </span>
                          <% end %>
                        </div>
                      <% end %>

                      <%= if candidate.source_url do %>
                        <div class="mt-4">
                          <a
                            href={candidate.source_url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-sm font-medium text-violet-700 hover:text-violet-900"
                          >
                            DNB-Datensatz öffnen ↗
                          </a>
                        </div>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
            <div>
              <dt class="text-xs font-medium uppercase tracking-wide text-zinc-500">
                Bester Score
              </dt>
              <dd class="mt-1 text-lg font-semibold text-zinc-900">
                {request.best_score || "—"}
              </dd>
            </div>

            <div>
              <dt class="text-xs font-medium uppercase tracking-wide text-zinc-500">
                Bewertung
              </dt>
              <dd class="mt-1 text-sm font-medium text-zinc-900">
                {decision_label(request.decision)}
              </dd>
            </div>
          </dl>
        </article>
      <% end %>
    <% end %>
  </div>
</section>
