<main
  class="min-h-screen text-zinc-950"
  style="background-color: var(--jj-background)"
>
  <section class="mx-auto max-w-7xl px-6 py-10 sm:px-8 lg:px-12">
    <header class="flex items-center justify-between">
      <a href={~p"/"} class="flex items-center gap-3">
        <img
          src={~p"/images/jejak-jati-logo.svg"}
          alt=""
          class="h-12 w-12 object-contain"
        />

        <div>
          <p class="text-lg font-semibold tracking-tight">
            Jejak Jati
          </p>

          <p class="text-xs uppercase tracking-[0.18em] text-zinc-500">
            Authority Research
          </p>
        </div>
      </a>

      <span class="hidden rounded-full border border-zinc-200 px-4 py-2 text-sm text-zinc-500 sm:inline-flex">
        MVP in Entwicklung
      </span>
    </header>

    <div class="grid min-h-[76vh] items-center gap-12 py-16 lg:grid-cols-[1fr_0.9fr] lg:gap-20">
      <section>
        <p class="text-sm font-semibold uppercase tracking-[0.22em] text-fuchsia-700">
          Evidenzbasierte Normdatenrecherche
        </p>

        <h1 class="mt-6 max-w-3xl text-5xl font-semibold leading-[1.05] tracking-tight sm:text-6xl lg:text-7xl">
          Spuren verfolgen.
          <span class="block bg-gradient-to-r from-orange-500 via-pink-600 to-violet-700 bg-clip-text text-transparent">
            Identitäten klären.
          </span>
        </h1>

        <p class="mt-8 max-w-2xl text-lg leading-8 text-zinc-600">
          Jejak Jati verbindet bibliografische Daten, Normdateien und
          nachvollziehbare Quellenbelege zu prüfbaren Personenkandidaten und
          Normdatensatzentwürfen.
        </p>

        <p class="mt-5 max-w-xl text-sm leading-6 text-zinc-500">
          Every assertion must be backed by traceable evidence.
        </p>

        <div class="mt-10 flex flex-col gap-4 sm:flex-row">
          <a
            href="#research"
            class="inline-flex items-center justify-center rounded-xl bg-gradient-to-r from-orange-500 via-pink-600 to-violet-700 px-6 py-3.5 text-sm font-semibold text-white shadow-sm transition hover:opacity-90"
          >
            Recherche starten
          </a>

          <a
            href="#about"
            class="inline-flex items-center justify-center rounded-xl border border-zinc-300 px-6 py-3.5 text-sm font-semibold text-zinc-700 transition hover:border-zinc-400 hover:bg-zinc-50"
          >
            Mehr über den Ansatz
          </a>
        </div>
      </section>

      <section class="relative flex items-center justify-center">
        <div class="absolute inset-10 -z-10 rounded-full bg-gradient-to-br from-orange-100 via-pink-100 to-violet-100 blur-3xl">
        </div>

        <img
          src={~p"/images/jejak-jati-logo.svg"}
          alt="Jejak-Jati-Logo: ein stilisierter malaiischer Wau mit Jawi-Kalligrafie"
          class="w-full max-w-xl object-contain"
        />
      </section>
    </div>
  </section>

  <section
    id="research"
    class="border-t border-zinc-200 bg-zinc-50"
  >
    <div class="mx-auto max-w-5xl px-6 py-20 sm:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-fuchsia-700">
          Neue Recherche
        </p>

        <h2 class="mt-4 text-3xl font-semibold tracking-tight sm:text-4xl">
          Werk und Person erfassen
        </h2>

        <p class="mt-4 text-base leading-7 text-zinc-600">
          Die Recherchefunktion wird im nächsten Entwicklungsschritt aktiviert.
        </p>
      </div>

      <div class="mx-auto mt-10 max-w-2xl rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm sm:p-8">
        <form class="space-y-6">
          <div>
            <label
              for="title"
              class="block text-sm font-medium text-zinc-800"
            >
              Buchtitel
            </label>

            <input
              id="title"
              name="title"
              type="text"
              disabled
              placeholder="Titel des Werkes"
              class="mt-2 block w-full rounded-xl border border-zinc-300 bg-zinc-100 px-4 py-3 text-zinc-500 shadow-sm"
            />
          </div>

          <div>
            <label
              for="author_name"
              class="block text-sm font-medium text-zinc-800"
            >
              Autorin oder Autor
            </label>

            <input
              id="author_name"
              name="author_name"
              type="text"
              disabled
              placeholder="Name der Person"
              class="mt-2 block w-full rounded-xl border border-zinc-300 bg-zinc-100 px-4 py-3 text-zinc-500 shadow-sm"
            />
          </div>

          <div>
            <label
              for="isbn"
              class="block text-sm font-medium text-zinc-800"
            >
              ISBN
              <span class="font-normal text-zinc-400">
                optional
              </span>
            </label>

            <input
              id="isbn"
              name="isbn"
              type="text"
              disabled
              placeholder="978-..."
              class="mt-2 block w-full rounded-xl border border-zinc-300 bg-zinc-100 px-4 py-3 text-zinc-500 shadow-sm"
            />
          </div>

          <button
            type="button"
            disabled
            class="w-full rounded-xl bg-zinc-300 px-5 py-3.5 text-sm font-semibold text-white"
          >
            Recherche starten
          </button>
        </form>
      </div>
    </div>
  </section>

  <section
    id="about"
    class="border-t border-zinc-200 bg-white"
  >
    <div class="mx-auto max-w-6xl px-6 py-20 sm:px-8">
      <div class="grid gap-8 md:grid-cols-3">
        <article>
          <p class="text-sm font-semibold text-orange-600">
            01
          </p>

          <h3 class="mt-3 text-xl font-semibold">
            Spuren sammeln
          </h3>

          <p class="mt-3 text-sm leading-6 text-zinc-600">
            Bibliografische Datensätze und Normdateien werden als getrennte,
            nachvollziehbare Quellen ausgewertet.
          </p>
        </article>

        <article>
          <p class="text-sm font-semibold text-pink-600">
            02
          </p>

          <h3 class="mt-3 text-xl font-semibold">
            Identitäten abgleichen
          </h3>

          <p class="mt-3 text-sm leading-6 text-zinc-600">
            Personenkandidaten werden anhand von Werken, Identifikatoren,
            Namensformen und weiteren Belegen verglichen.
          </p>
        </article>

        <article>
          <p class="text-sm font-semibold text-violet-700">
            03
          </p>

          <h3 class="mt-3 text-xl font-semibold">
            Entscheidungen belegen
          </h3>

          <p class="mt-3 text-sm leading-6 text-zinc-600">
            Jeder vorgeschlagene Feldwert bleibt mit Quelle, Status und
            Begründung überprüfbar.
          </p>
        </article>
      </div>
    </div>
  </section>

  <footer class="border-t border-zinc-200 bg-zinc-50">
    <div class="mx-auto flex max-w-7xl flex-col gap-3 px-6 py-8 text-sm text-zinc-500 sm:flex-row sm:items-center sm:justify-between sm:px-8 lg:px-12">
      <p>
        Jejak Jati
      </p>

      <p>
        Evidenzbasierte Recherche für prüfbare Normdaten.
      </p>
    </div>
  </footer>
</main>
